# AETHEON model configuration
# Choose ONE provider configuration and uncomment it.
# Gemini Developer API (recommended)
# ORCHESTRATOR_PROVIDER=google
# ORCHESTRATOR_MODEL=gemini-3.8-flash
# ORCHESTRATOR_API_KEY=your-google-ai-studio-api-key
#
# CYPHER_PROVIDER=google
# CYPHER_MODEL=gemini-3.5-flash-lite
# CYPHER_API_KEY=your-google-ai-studio-api-key
#
# Ollama (local)
# ORCHESTRATOR_PROVIDER=ollama
# ORCHESTRATOR_MODEL=llama3.2
# ORCHESTRATOR_ENDPOINT=http://localhost:11434/v1
# CYPHER_PROVIDER=ollama
# CYPHER_MODEL=codellama
# CYPHER_ENDPOINT=http://localhost:11434/v1
#
# OpenAI
# ORCHESTRATOR_PROVIDER=openai
# ORCHESTRATOR_MODEL=gpt-4o
# ORCHESTRATOR_API_KEY=your-openai-api-key
# CYPHER_PROVIDER=openai
# CYPHER_MODEL=gpt-4o-mini
# CYPHER_API_KEY=your-openai-api-key
#
# Azure OpenAI
# ORCHESTRATOR_PROVIDER=azure
# ORCHESTRATOR_MODEL=gpt-4o
# ORCHESTRATOR_ENDPOINT=https://your-resource.openai.azure.com/
# ORCHESTRATOR_API_KEY=your-azure-api-key
# ORCHESTRATOR_API_VERSION=your-api-version
# CYPHER_PROVIDER=azure
# CYPHER_MODEL=gpt-4o
# CYPHER_ENDPOINT=https://your-resource.openai.azure.com/
# CYPHER_API_KEY=your-azure-api-key
# CYPHER_API_VERSION=your-api-version

# Memgraph settings
MEMGRAPH_HOST=localhost
MEMGRAPH_PORT=7687
MEMGRAPH_HTTP_PORT=7444
LAB_PORT=3000

# Redis settings
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_REDIS_DB=0
FAST_REDIS_DB=1
